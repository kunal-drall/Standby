{
  "name": "@standby/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Settles past-due loans and serves the read API (docs/interfaces.md section 6).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --env-file-if-exists=../.env --watch dist/index.js",
    "start": "node --env-file-if-exists=../.env dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "1.19.18",
    "@standby/shared": "workspace:*",
    "hono": "4.13.16",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
